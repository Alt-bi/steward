{
  "manifest_version": 3,
  "name": "Steam Reprice",
  "short_name": "Reprice",
  "version": "1.1.1",
  "description": "Сканирует ваши лоты Steam Community Market и переставляет оверпрайс на 1 копейку ниже чужого минимума.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Steam Reprice",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://steamcommunity.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://steamcommunity.com/market/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://steamcommunity.com/market/*"],
      "js": ["fees.js", "steam.js", "panel.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
